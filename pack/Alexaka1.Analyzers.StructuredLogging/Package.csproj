<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Version.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Alexaka1.Analyzers.StructuredLogging</PackageId>
    <Authors>alexaka1</Authors>
    <Copyright>Copyright (c) 2026 alexaka1</Copyright>
    <Description>Roslyn analyzers and code fixes for structured logging templates (Serilog, NLog, Microsoft.Extensions.Logging, ZLogger).</Description>
    <PackageTags>analyzers;roslyn;serilog;nlog;logging;structured-logging</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/alexaka1/structured-logging-analyzers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/alexaka1/structured-logging-analyzers</PackageProjectUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Alexaka1.Analyzers.StructuredLogging\Analyzer.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\Alexaka1.Analyzers.StructuredLogging.CodeFixes\CodeFixes.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\docs\package-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\PROVENANCE.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerFiles</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="PreparePackAnalyzerFiles">
    <PropertyGroup>
      <BuildProjectReferences>false</BuildProjectReferences>
    </PropertyGroup>
  </Target>
  <Target Name="PackAnalyzerFiles" DependsOnTargets="PreparePackAnalyzerFiles;ResolveProjectReferences">
    <ItemGroup>
      <_AnalyzerAssembly Include="@(_ResolvedProjectReferencePaths)"
                         Condition="'%(Filename)%(Extension)' == 'Alexaka1.Analyzers.StructuredLogging.dll'" />
      <_CodeFixAssembly Include="@(_ResolvedProjectReferencePaths)"
                        Condition="'%(Filename)%(Extension)' == 'Alexaka1.Analyzers.StructuredLogging.CodeFixes.dll'" />
    </ItemGroup>
    <Error Condition="'@(_AnalyzerAssembly->Count())' != '1'"
           Text="Expected exactly one resolved Alexaka1.Analyzers.StructuredLogging.dll project-reference output, found @(_AnalyzerAssembly->Count())." />
    <Error Condition="'@(_CodeFixAssembly->Count())' != '1'"
           Text="Expected exactly one resolved Alexaka1.Analyzers.StructuredLogging.CodeFixes.dll project-reference output, found @(_CodeFixAssembly->Count())." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_AnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="@(_CodeFixAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
