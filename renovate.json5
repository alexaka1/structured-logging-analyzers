{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'github>alexaka1/renovate-config',
    'github>alexaka1/renovate-config:monorepos',
    'github>alexaka1/renovate-config//opinionated/schedules',
    'github>alexaka1/renovate-config//opinionated/labels',
    'github>alexaka1/renovate-config//opinionated/security',
    ':automergePr',
    ':automergePatch',
    ':automergeMinor',
    ':automergeDigest',
    ':automergeRequireAllStatusChecks',
    ':rebaseStalePrs',
    ':pinDependencies',
    'security:minimumReleaseAgeNpm',
  ],
  baseBranchPatterns: [
    '$default',
    '/^beta$/',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Latest logging-library canary versions in the analyzer package matrix',
      managerFilePatterns: [
        '/(^|/)PackageVersionMatrix\\.cs$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+public const string \\w+ = "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'nuget',
      versioningTemplate: 'nuget',
    },
  ],
  packageRules: [
    {
      description: [
        "Ignore pnpm workspace overrides",
      ],
      matchManagers: ["npm"],
      matchDepTypes: ["pnpm-workspace.overrides"],
      matchFileNames: ["pnpm-workspace.yaml"],
      enabled: false,
    },
    {
      description: [
        "Use NuGet versioning for ReSharper global tool four-part versions",
      ],
      matchFileNames: ["dotnet-tools.json"],
      matchManagers: ["nuget"],
      matchPackageNames: ["jetbrains.resharper.globaltools"],
      versioning: "nuget",
    },
    {
      description: [
        "Keep the analyzer compile-time Roslyn API at the VS 2022 17.8 floor",
      ],
      matchManagers: ["nuget"],
      matchPackageNames: [
        "Microsoft.CodeAnalysis.CSharp",
        "Microsoft.CodeAnalysis.CSharp.Workspaces",
      ],
      enabled: false,
    },
    {
      description: [
        "Do not major-bump logging libraries in the default test host; majors are restored from PackageVersionMatrix.cs",
      ],
      matchManagers: ["nuget"],
      matchPackageNames: [
        "Serilog",
        "NLog",
        "ZLogger",
        "Microsoft.Extensions.Logging.Abstractions",
      ],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
  ],
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/examples/**',
    '**/samples/**',
    // Frozen InspectCode vs Roslyn parity harness; not a consumption project.
    '**/test/comparison/**',
    '**/__tests__/**',
    '**/tests/**',
    '**/__fixtures__/**',
  ],
  nuget: {
    managerFilePatterns: [
      '/(^|/)build\\/.*\\.cs$/',
    ],
  },
}
