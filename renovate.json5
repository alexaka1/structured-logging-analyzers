{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'github>alexaka1/renovate-config',
    'github>alexaka1/renovate-config:monorepos',
    'github>alexaka1/renovate-config//opinionated/schedules',
    'github>alexaka1/renovate-config//opinionated/labels',
    'github>alexaka1/renovate-config//opinionated/security',
    ':automergePr',
    ':automergePatch',
    ':automergeMinor',
    ':automergeDigest',
    ':automergeRequireAllStatusChecks',
    ':rebaseStalePrs',
    ':pinDependencies',
    'security:minimumReleaseAgeNpm',
  ],
  baseBranchPatterns: [
    '$default',
    '/^beta$/',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Latest-stable logging-library versions in PackageVersionMatrix.cs, including majors',
      managerFilePatterns: [
        '/(^|/)PackageVersionMatrix\\.cs$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+public const string \\w+ = "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'nuget',
      versioningTemplate: 'nuget',
    },
  ],
  packageRules: [
    {
      description: [
        "Ignore pnpm workspace overrides",
      ],
      matchManagers: ["npm"],
      matchDepTypes: ["pnpm-workspace.overrides"],
      matchFileNames: ["pnpm-workspace.yaml"],
      enabled: false,
    },
    {
      description: [
        "Use NuGet versioning for ReSharper global tool four-part versions",
      ],
      matchFileNames: ["dotnet-tools.json"],
      matchManagers: ["nuget"],
      matchPackageNames: ["jetbrains.resharper.globaltools"],
      versioning: "nuget",
    },
    {
      description: [
        "Ignore sample consumer projects",
        "Top-level ignorePaths does not apply to nuget when :ignoreModulesAndTests is in the preset chain",
      ],
      matchFileNames: [
        "**/samples/**",
      ],
      enabled: false,
    },
    {
      description: [
        "Ignore the frozen InspectCode vs Roslyn parity harness",
        "Top-level ignorePaths does not apply to nuget when :ignoreModulesAndTests is in the preset chain",
      ],
      matchFileNames: [
        "**/test/comparison/**",
      ],
      enabled: false,
    },
    {
      description: [
        "Keep the analyzer compile-time Roslyn API at the VS 2022 17.8 floor",
      ],
      matchManagers: ["nuget"],
      matchPackageNames: [
        "Microsoft.CodeAnalysis.CSharp",
        "Microsoft.CodeAnalysis.CSharp.Workspaces",
      ],
      enabled: false,
    },
    {
      description: [
        "Keep Microsoft.CodeAnalysis.Analyzers on the 3.x line used with the 4.8 API floor",
        "5.x is version-aligned with Roslyn 5 / VS 2026 and groups as dotnet-monorepo",
      ],
      matchManagers: ["nuget"],
      matchPackageNames: [
        "Microsoft.CodeAnalysis.Analyzers",
      ],
      allowedVersions: "<4",
    },
    {
      description: [
        "Do not major-bump other Microsoft.CodeAnalysis.* packages; 5.x is Roslyn 5 / VS 2026",
      ],
      matchManagers: ["nuget"],
      matchPackageNames: [
        "Microsoft.CodeAnalysis",
        "Microsoft.CodeAnalysis.*",
      ],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: [
        "Do not major-bump logging libraries in the default test host; majors are restored from PackageVersionMatrix.cs",
      ],
      matchManagers: ["nuget"],
      matchPackageNames: [
        "Serilog",
        "NLog",
        "ZLogger",
        "Microsoft.Extensions.Logging.Abstractions",
      ],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: [
        "Always track latest-stable logging versions in PackageVersionMatrix.cs, including majors",
      ],
      matchFileNames: ["**/PackageVersionMatrix.cs"],
      matchPackageNames: [
        "Serilog",
        "NLog",
        "ZLogger",
        "Microsoft.Extensions.Logging.Abstractions",
      ],
      enabled: true,
    },
    {
      description: [
        "Do not automerge major bumps of latest-stable logging versions; APIs can change",
      ],
      matchFileNames: ["**/PackageVersionMatrix.cs"],
      matchPackageNames: [
        "Serilog",
        "NLog",
        "ZLogger",
        "Microsoft.Extensions.Logging.Abstractions",
      ],
      matchUpdateTypes: ["major"],
      automerge: false,
    },
  ],
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/examples/**',
    '**/samples/**',
    // Frozen InspectCode vs Roslyn parity harness; not a consumption project.
    '**/test/comparison/**',
    '**/__tests__/**',
    '**/tests/**',
    '**/__fixtures__/**',
  ],
  nuget: {
    managerFilePatterns: [
      '/(^|/)build\\/.*\\.cs$/',
    ],
    // :ignoreModulesAndTests (via config:best-practices) sets nuget.ignorePaths
    // without samples/ or test/. Top-level ignorePaths does not merge into that
    // manager list, so these paths must be repeated here.
    ignorePaths: [
      '**/node_modules/**',
      '**/bower_components/**',
      '**/vendor/**',
      '**/examples/**',
      '**/samples/**',
      '**/test/comparison/**',
      '**/__fixtures__/**',
    ],
  },
}
